---
import { getCollection } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import settings from "../data/settings.json";

const allPosts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const recentPosts = allPosts.slice(0, 4);

const counts: Record<string, number> = {};
for (const cat of settings.categories) counts[cat] = 0;
for (const post of allPosts) {
	const c = post.data.category || "Self-Hosting";
	counts[c] = (counts[c] || 0) + 1;
}

const resolveImg = (img?: string) => {
	if (!img) return "/blog-placeholder-1.jpg";
	return img.replace("../../assets/", "/");
};
---

<aside class="sidebar">
	<div class="widget">
		<h3 class="widget-title">{settings.aboutTitle}</h3>
		<p style="margin: 0; font-size: 0.9rem; color: var(--text-muted);">
			{settings.aboutText}
		</p>
	</div>

	<div class="widget">
		<h3 class="widget-title">Kategorien</h3>
		<ul class="cat-list">
			{Object.entries(counts).map(([name, count]) => (
				<li>
					<span>{name}</span>
					<span class="cat-count">{count}</span>
				</li>
			))}
		</ul>
	</div>

	<div class="widget">
		<h3 class="widget-title">Neueste Beiträge</h3>
		<div class="recent-list">
			{recentPosts.map((post) => (
				<a href={`/blog/${post.id}/`} class="recent-item">
					<img src={resolveImg(post.data.heroImage)} alt={post.data.title} loading="lazy" />
					<div>
						<div class="recent-title">{post.data.title}</div>
						<div class="meta-date"><FormattedDate date={post.data.pubDate} /></div>
					</div>
				</a>
			))}
		</div>
	</div>
</aside>

<style>
	.cat-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
	}
	.cat-list li {
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-size: 0.9rem;
		color: var(--text-muted);
		padding: 0.35rem 0;
		border-bottom: 1px dashed rgba(255, 255, 255, 0.06);
	}
	.cat-count {
		background: var(--bg-elevated);
		color: var(--accent-light);
		font-size: 0.75rem;
		font-weight: 700;
		padding: 0.1rem 0.5rem;
		border-radius: 99px;
	}
	.recent-list {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}
	.recent-item {
		display: grid;
		grid-template-columns: 72px 1fr;
		gap: 0.75rem;
		align-items: center;
	}
	.recent-item img {
		width: 72px;
		height: 50px;
		object-fit: cover;
		border-radius: 6px;
		border: 1px solid var(--border);
	}
	.recent-title {
		font-size: 0.88rem;
		font-weight: 600;
		line-height: 1.3;
		color: var(--text-main);
		margin-bottom: 0.2rem;
	}
	.recent-item:hover .recent-title {
		color: var(--accent-light);
	}
</style>