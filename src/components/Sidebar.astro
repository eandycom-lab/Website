---
import { getCollection } from "astro:content";
import FormattedDate from "./FormattedDate.astro";
import settings from "../data/settings.json";

const allPosts = (await getCollection("blog")).sort(
(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const recentPosts = allPosts.slice(0, 4);

const counts: Record<string, number> = {};
for (const cat of settings.categories) counts[cat] = 0;
for (const post of allPosts) {
const c = post.data.category || "Self-Hosting";
counts[c] = (counts[c] || 0) + 1;
}

const slugify = (text: string) =>
text
.toLowerCase()
.replace(/ä/g, "ae")
.replace(/ö/g, "oe")
.replace(/ü/g, "ue")
.replace(/ß/g, "ss")
.replace(/[^a-z0-9]+/g, "-")
.replace(/(^-|-$)/g, "");

const resolveImg = (img?: string) => {
if (!img) return "/blog-placeholder-1.jpg";
return img.replace("../../assets/", "/");
};
---

<aside class="sidebar">
<div class="widget">
<h3 class="widget-title">Suche</h3>
<div class="search-box">
<input
type="search"
id="blog-search-input"
placeholder="Artikel durchsuchen..."
autocomplete="off"
aria-label="Artikel durchsuchen"
/>
<div id="blog-search-results" class="search-results"></div>
</div>
</div>

<div class="widget">
<h3 class="widget-title">{settings.aboutTitle}</h3>
<div class="about-box">
{settings.aboutImage && (
<img
src={resolveImg(settings.aboutImage)}
alt={settings.aboutTitle}
class="about-avatar"
/>
)}
<p class="about-text">
{settings.aboutText}
</p>
</div>
</div>

<div class="widget">
<h3 class="widget-title">Kategorien</h3>
<ul class="cat-list">
{Object.entries(counts).map(([name, count]) => (
<li>
<a href={`/category/${slugify(name)}/`} class="cat-link">
<span>{name}</span>
<span class="cat-count">{count}</span>
</a>
</li>
))}
</ul>
</div>

<div class="widget">
<h3 class="widget-title">Neueste Beiträge</h3>
<div class="recent-list">
{recentPosts.map((post) => (
<a href={`/blog/${post.id}/`} class="recent-item">
<img src={resolveImg(post.data.heroImage)} alt={post.data.title} loading="lazy" />
<div>
<div class="recent-title">{post.data.title}</div>
<div class="meta-date"><FormattedDate date={post.data.pubDate} /></div>
</div>
</a>
))}
</div>
</div>
</aside>

<script is:inline>
(function () {
const input = document.getElementById("blog-search-input");
const resultsBox = document.getElementById("blog-search-results");
if (!input || !resultsBox) return;

let pagefind = null;
let debounceTimer = null;

async function loadPagefind() {
if (pagefind) return pagefind;
try {
pagefind = await import("/pagefind/pagefind.js");
await pagefind.init();
} catch (e) {
console.warn("Pagefind Index noch nicht geladen:", e);
}
return pagefind;
}

input.addEventListener("focus", loadPagefind, { once: true });

input.addEventListener("input", () => {
clearTimeout(debounceTimer);
const query = input.value.trim();
if (query.length < 2) {
resultsBox.innerHTML = "";
resultsBox.style.display = "none";
return;
}

debounceTimer = setTimeout(async () => {
const pf = await loadPagefind();
if (!pf) {
resultsBox.innerHTML = "<div class=\"search-empty\">Suche wird nach dem Build aktiv.</div>";
resultsBox.style.display = "block";
return;
}

const search = await pf.search(query);
if (!search.results.length) {
resultsBox.innerHTML = "<div class=\"search-empty\">Keine Treffer gefunden.</div>";
resultsBox.style.display = "block";
return;
}

const items = await Promise.all(search.results.slice(0, 5).map((r) => r.data()));
resultsBox.innerHTML = items
.map(
(item) => `
<a href="${item.url}" class="search-hit">
<div class="search-hit-title">${item.meta?.title || item.url}</div>
<div class="search-hit-excerpt">${item.excerpt}</div>
</a>
`
)
.join("");
resultsBox.style.display = "block";
}, 180);
});
})();
</script>

<style>
.search-box {
position: relative;
}
#blog-search-input {
width: 100%;
padding: 0.6rem 0.85rem;
border-radius: 7px;
border: 1px solid var(--border);
background: var(--bg-main);
color: var(--text-main);
font-size: 0.9rem;
outline: none;
transition: border-color 0.15s ease;
}
#blog-search-input:focus {
border-color: var(--accent);
}
.search-results {
display: none;
margin-top: 0.65rem;
flex-direction: column;
gap: 0.5rem;
}
:global(.search-hit) {
display: block;
padding: 0.6rem 0.7rem;
border-radius: 6px;
background: var(--bg-elevated);
border: 1px solid var(--border);
margin-bottom: 0.45rem;
}
:global(.search-hit:hover) {
border-color: var(--accent);
}
:global(.search-hit-title) {
font-size: 0.86rem;
font-weight: 600;
color: var(--text-main);
margin-bottom: 0.2rem;
}
:global(.search-hit-excerpt) {
font-size: 0.78rem;
color: var(--text-muted);
line-height: 1.4;
}
:global(.search-hit-excerpt mark) {
background: rgba(59, 130, 246, 0.3);
color: var(--text-main);
border-radius: 2px;
padding: 0 2px;
}
:global(.search-empty) {
font-size: 0.82rem;
color: var(--text-dim);
padding: 0.35rem 0.2rem;
}
.about-box {
overflow: hidden;
}
.about-avatar {
width: 76px;
height: 76px;
border-radius: 50%;
object-fit: cover;
float: left;
margin: 0.15rem 1rem 0.4rem 0;
border: 2px solid var(--border-hover);
}
.about-text {
margin: 0;
font-size: 0.9rem;
color: var(--text-muted);
line-height: 1.55;
}
.cat-list {
list-style: none;
padding: 0;
margin: 0;
display: flex;
flex-direction: column;
gap: 0.25rem;
}
.cat-list li {
border-bottom: 1px dashed rgba(255, 255, 255, 0.06);
}
.cat-link {
display: flex;
justify-content: space-between;
align-items: center;
font-size: 0.9rem;
color: var(--text-muted);
padding: 0.5rem 0.4rem;
border-radius: 6px;
transition: background 0.15s ease, color 0.15s ease;
}
.cat-link:hover {
background: var(--bg-elevated);
color: var(--text-main);
}
.cat-count {
background: var(--bg-elevated);
color: var(--accent-light);
font-size: 0.75rem;
font-weight: 700;
padding: 0.1rem 0.5rem;
border-radius: 99px;
}
.recent-list {
display: flex;
flex-direction: column;
gap: 0.9rem;
}
.recent-item {
display: grid;
grid-template-columns: 72px 1fr;
gap: 0.75rem;
align-items: center;
}
.recent-item img {
width: 72px;
height: 50px;
object-fit: cover;
border-radius: 6px;
border: 1px solid var(--border);
}
.recent-title {
font-size: 0.88rem;
font-weight: 600;
line-height: 1.3;
color: var(--text-main);
margin-bottom: 0.2rem;
}
.recent-item:hover .recent-title {
color: var(--accent-light);
}
</style>
