---
import { getCollection } from "astro:content";
import settings from "../data/settings.json";

const allPosts = await getCollection("blog");

const slugify = (text: string) =>
text
.toLowerCase()
.replace(/ä/g, "ae")
.replace(/ö/g, "oe")
.replace(/ü/g, "ue")
.replace(/ß/g, "ss")
.replace(/[^a-z0-9]+/g, "-")
.replace(/(^-|-$)/g, "");

// Kategorien mit Artikelanzahl
const categoryCounts = new Map<string, number>();
for (const cat of settings.categories) {
categoryCounts.set(cat, 0);
}
for (const post of allPosts) {
const cat = post.data.category || "Self-Hosting";
categoryCounts.set(cat, (categoryCounts.get(cat) ?? 0) + 1);
}

// Tags zählen und nach Häufigkeit sortieren (Top 16)
const tagCounts = new Map<string, { label: string; count: number }>();
for (const post of allPosts) {
for (const rawTag of post.data.tags ?? []) {
const key = rawTag.toLowerCase();
const existing = tagCounts.get(key);
if (existing) {
existing.count += 1;
} else {
tagCounts.set(key, { label: rawTag, count: 1 });
}
}
}
const popularTags = Array.from(tagCounts.values())
.sort((a, b) => b.count - a.count || a.label.localeCompare(b.label, "de"))
.slice(0, 16);

const resolveImg = (img?: string) => {
if (!img) return "/blog-placeholder-1.jpg";
return img.replace("../../assets/", "/");
};
---

<aside class="sidebar-stack" data-pagefind-ignore>
<!-- 1. Über das Projekt -->
<div class="sidebar-box">
<h3 class="sidebar-title">{settings.aboutTitle || "Über das Projekt"}</h3>
{settings.aboutImage && (
<img
class="about-img"
src={resolveImg(settings.aboutImage)}
alt={settings.aboutTitle || "Über das Projekt"}
loading="lazy"
/>
)}
<p class="about-text">{settings.aboutText}</p>
</div>

<!-- 2. Volltextsuche (Pagefind) -->
<div class="sidebar-box">
<h3 class="sidebar-title">Suche</h3>
<div class="search-wrap">
<input
type="search"
id="sidebar-search-input"
class="search-input"
placeholder="Artikel, Tools, Tags suchen..."
aria-label="Blog durchsuchen"
autocomplete="off"
/>
<div id="sidebar-search-results" class="search-results" hidden></div>
</div>
</div>

<!-- 3. Kategorien -->
<div class="sidebar-box">
<h3 class="sidebar-title">Kategorien</h3>
<ul class="cat-list">
{Array.from(categoryCounts.entries()).map(([cat, count]) => (
<li>
<a href={`/category/${slugify(cat)}/`} class="cat-link">
<span>{cat}</span>
<span class="cat-count">{count}</span>
</a>
</li>
))}
</ul>
</div>

<!-- 4. Beliebte Tags (Tag-Cloud) -->
{popularTags.length > 0 && (
<div class="sidebar-box">
<h3 class="sidebar-title">Beliebte Tags</h3>
<div class="tag-cloud">
{popularTags.map((t) => (
<a href={`/tag/${slugify(t.label)}/`} class="cloud-tag" title={`${t.count} Artikel`}>
#{t.label}
</a>
))}
</div>
</div>
)}

<!-- 5. RSS & Updates Box -->
<div class="sidebar-box updates-box">
<h3 class="sidebar-title">Updates & Feed</h3>
<p class="updates-text">
Keine neuen Guides zu Linux, Docker-Stacks & Local AI verpassen:
</p>
<div class="updates-actions">
<a href="/rss.xml" class="update-btn rss-btn" target="_blank" rel="noopener">
<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<path d="M4 11a9 9 0 0 1 9 9" />
<path d="M4 4a16 16 0 0 1 16 16" />
<circle cx="5" cy="19" r="1" />
</svg>
RSS-Feed
</a>
<a href="/kontakt" class="update-btn mail-btn">
<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
<rect width="20" height="16" x="2" y="4" rx="2" />
<path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
</svg>
Newsletter
</a>
</div>
</div>
</aside>

<script is:inline>
(function () {
const input = document.getElementById("sidebar-search-input");
const resultsBox = document.getElementById("sidebar-search-results");
if (!input || !resultsBox) return;

let pagefind = null;
let debounceTimer = null;

async function loadPagefind() {
if (pagefind) return pagefind;
try {
pagefind = await import("/pagefind/pagefind.js");
await pagefind.init();
} catch {
pagefind = null;
}
return pagefind;
}

input.addEventListener("focus", loadPagefind, { once: true });

input.addEventListener("input", () => {
clearTimeout(debounceTimer);
const q = input.value.trim();

if (q.length < 2) {
resultsBox.hidden = true;
resultsBox.innerHTML = "";
return;
}

debounceTimer = setTimeout(async () => {
const pf = await loadPagefind();
if (!pf) {
resultsBox.hidden = false;
resultsBox.innerHTML = `<div class="search-empty">Suche ist erst im Live-Build verfügbar.</div>`;
return;
}

const search = await pf.search(q);
const topResults = await Promise.all(
search.results.slice(0, 5).map((r) => r.data())
);

if (topResults.length === 0) {
resultsBox.innerHTML = `<div class="search-empty">Keine Treffer für „${q}“.</div>`;
} else {
resultsBox.innerHTML = topResults
.map(
(item) => `
<a href="${item.url}" class="search-hit">
<span class="hit-title">${item.meta?.title || item.url}</span>
<span class="hit-excerpt">${item.excerpt || ""}</span>
</a>
`
)
.join("");
}
resultsBox.hidden = false;
}, 180);
});

document.addEventListener("click", (e) => {
if (!input.contains(e.target) && !resultsBox.contains(e.target)) {
resultsBox.hidden = true;
}
});
})();
</script>

<style>
.sidebar-stack {
display: flex;
flex-direction: column;
gap: 1.5rem;
}
.sidebar-box {
background: var(--bg-card);
border: 1px solid var(--border);
border-radius: 12px;
padding: 1.25rem;
}
.sidebar-title {
font-size: 0.85rem;
font-weight: 700;
text-transform: uppercase;
letter-spacing: 0.06em;
color: var(--text-main);
margin: 0 0 0.9rem 0;
padding-bottom: 0.55rem;
border-bottom: 1px solid var(--border);
}
.about-img {
width: 100%;
aspect-ratio: 16 / 9;
object-fit: cover;
border-radius: 8px;
margin-bottom: 0.85rem;
border: 1px solid var(--border);
}
.about-text {
font-size: 0.9rem;
line-height: 1.55;
color: var(--text-muted);
margin: 0;
}
.search-wrap {
position: relative;
}
.search-input {
width: 100%;
padding: 0.6rem 0.8rem;
border-radius: 8px;
border: 1px solid var(--border);
background: var(--bg-main);
color: var(--text-main);
font-family: inherit;
font-size: 0.9rem;
outline: none;
transition: border-color 0.15s ease;
}
.search-input:focus {
border-color: var(--accent);
}
.search-results {
margin-top: 0.65rem;
display: flex;
flex-direction: column;
gap: 0.5rem;
}
.search-results[hidden] {
display: none;
}
:global(.search-hit) {
display: block;
padding: 0.6rem 0.7rem;
border-radius: 7px;
background: var(--bg-main);
border: 1px solid var(--border);
text-decoration: none;
transition: border-color 0.15s ease;
}
:global(.search-hit:hover) {
