}
:global(.hit-title) {
display: block;
font-size: 0.85rem;
font-weight: 700;
color: var(--text-main);
margin-bottom: 0.2rem;
}
:global(.hit-excerpt) {
display: block;
font-size: 0.78rem;
line-height: 1.4;
color: var(--text-muted);
}
:global(.hit-excerpt mark) {
background: rgba(59, 130, 246, 0.28);
color: var(--accent-light);
padding: 0 2px;
border-radius: 3px;
}
:global(.search-empty) {
font-size: 0.82rem;
color: var(--text-dim);
padding: 0.35rem 0;
}
.cat-list {
list-style: none;
padding: 0;
margin: 0;
display: flex;
flex-direction: column;
gap: 0.45rem;
}
.cat-link {
display: flex;
align-items: center;
justify-content: space-between;
padding: 0.45rem 0.65rem;
border-radius: 7px;
font-size: 0.9rem;
color: var(--text-muted);
background: rgba(15, 23, 42, 0.45);
border: 1px solid transparent;
transition: all 0.15s ease;
}
.cat-link:hover {
