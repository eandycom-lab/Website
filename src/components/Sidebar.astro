.rss-btn:hover {
background: rgba(249, 115, 22, 0.2);
color: #fdba74;
}
.mail-btn {
background: rgba(59, 130, 246, 0.12);
border: 1px solid rgba(59, 130, 246, 0.35);
color: var(--accent-light);
}
.mail-btn:hover {
background: rgba(59, 130, 246, 0.2);
color: #93c5fd;
