---
import { SITE_TITLE } from "../consts";

const isSysAI = SITE_TITLE.toLowerCase().startsWith("sysai");
const suffix = isSysAI ? SITE_TITLE.slice(5).trim() : "";
---

<header class="site-header">
<div class="container header-inner">
<a href="/" class="brand" aria-label={SITE_TITLE}>
<svg
class="brand-icon"
viewBox="0 0 40 40"
fill="none"
xmlns="http://www.w3.org/2000/svg"
aria-hidden="true"
>
<defs>
<linearGradient id="brand-grad" x1="4" y1="4" x2="36" y2="36" gradientUnits="userSpaceOnUse">
<stop offset="0%" stop-color="#3b82f6" />
<stop offset="100%" stop-color="#22d3ee" />
</linearGradient>
</defs>
<rect x="4" y="7" width="13" height="7" rx="2" stroke="url(#brand-grad)" stroke-width="2.1" />
<rect x="4" y="16.5" width="13" height="7" rx="2" stroke="url(#brand-grad)" stroke-width="2.1" />
<rect x="4" y="26" width="13" height="7" rx="2" stroke="url(#brand-grad)" stroke-width="2.1" />
<circle cx="7.5" cy="10.5" r="1.1" fill="#22d3ee" />
<circle cx="7.5" cy="20" r="1.1" fill="#22d3ee" />
<circle cx="7.5" cy="29.5" r="1.1" fill="#22d3ee" />
<path
d="M17 10.5H25.5L29 7M17 20H31.5M17 29.5H25.5L29 33M23.5 10.5V16H27.5M23.5 29.5V24H27.5"
stroke="url(#brand-grad)"
stroke-width="2.1"
stroke-linecap="round"
stroke-linejoin="round"
/>
<circle cx="30" cy="6.5" r="2.3" fill="#22d3ee" />
<circle cx="33.5" cy="20" r="2.5" fill="#38bdf8" />
<circle cx="30" cy="33.5" r="2.3" fill="#22d3ee" />
<circle cx="28.5" cy="16" r="1.7" fill="#60a5fa" />
<circle cx="28.5" cy="24" r="1.7" fill="#60a5fa" />
</svg>

{isSysAI ? (
<span class="brand-wordmark">
<span class="brand-sys">Sys</span><span class="brand-ai">AI</span>
{suffix && <span class="brand-sub">{suffix}</span>}
</span>
) : (
<span class="brand-text">{SITE_TITLE}</span>
)}
</a>

<nav class="nav-links">
<a href="/">Home</a>
<a href="/blog">Artikel</a>
<a href="/about">Über</a>
<a href="/admin/" class="cms-btn">CMS</a>
</nav>
</div>
</header>

<style>
.site-header {
position: sticky;
top: 0;
z-index: 50;
background: rgba(11, 15, 25, 0.88);
backdrop-filter: blur(12px);
border-bottom: 1px solid var(--border);
}
.header-inner {
display: flex;
align-items: center;
justify-content: space-between;
height: 70px;
}
.brand {
display: flex;
align-items: center;
gap: 0.75rem;
color: var(--text-main);
text-decoration: none;
}
.brand-icon {
width: 36px;
height: 36px;
flex-shrink: 0;
filter: drop-shadow(0 0 8px rgba(34, 211, 238, 0.35));
transition: transform 0.25s ease, filter 0.25s ease;
}
.brand:hover .brand-icon {
transform: scale(1.06);
filter: drop-shadow(0 0 12px rgba(34, 211, 238, 0.6));
}
.brand-wordmark {
display: inline-flex;
align-items: baseline;
font-size: 1.4rem;
letter-spacing: -0.03em;
line-height: 1;
}
.brand-sys {
font-weight: 800;
color: var(--text-main);
}
.brand-ai {
font-weight: 800;
background: linear-gradient(135deg, #3b82f6 0%, #22d3ee 100%);
-webkit-background-clip: text;
-webkit-text-fill-color: transparent;
background-clip: text;
}
.brand-sub {
font-weight: 400;
color: var(--text-muted);
margin-left: 0.35rem;
font-size: 1.25rem;
letter-spacing: -0.01em;
}
.nav-links {
display: flex;
align-items: center;
gap: 1.5rem;
font-size: 0.95rem;
font-weight: 500;
color: var(--text-muted);
}
.nav-links a:hover {
color: var(--text-main);
}
.cms-btn {
padding: 0.35rem 0.75rem;
border-radius: 6px;
background: var(--bg-elevated);
border: 1px solid var(--border);
color: var(--text-main) !important;
font-size: 0.8rem;
}
.cms-btn:hover {
border-color: var(--accent);
}
</style>
