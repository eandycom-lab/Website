---
import { SITE_TITLE } from "../consts";
const today = new Date();
---

<footer class="site-footer">
<div class="container">
&copy; {today.getFullYear()} {SITE_TITLE} • Powered by Astro, Decap CMS & Cloudflare Pages
</div>
</footer>

<style>
.site-footer {
border-top: 1px solid var(--border);
padding: 2rem 0;
text-align: center;
font-size: 0.85rem;
color: var(--text-dim);
background: #080b12;
}
</style>
