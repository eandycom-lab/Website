---
interface Props {
  title: string;
  url: string;
}

const { title, url } = Astro.props;
const encodedTitle = encodeURIComponent(title);
const encodedUrl = encodeURIComponent(url);
---

<div class="share-bar" data-pagefind-ignore>
  <span class="share-label">Artikel teilen:</span>
  <div class="share-buttons">
    <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Auf LinkedIn teilen" class="share-pill">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
      <span>LinkedIn</span>
    </a>
    <a href={`https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}`} target="_blank" rel="noopener noreferrer" aria-label="Auf X teilen" class="share-pill">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      <span>X</span>
    </a>
    <a href={`https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`} target="_blank" rel="noopener noreferrer" aria-label="Auf Reddit teilen" class="share-pill">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M12 2A10 10 0 0 0 2 12a10 10 0 0 0 10 10 10 10 0 0 0 10-10A10 10 0 0 0 12 2m5.8 11.33c.02.16.03.33.03.5 0 2.55-2.97 4.62-6.63 4.62s-6.63-2.07-6.63-4.62c0-.17.01-.34.03-.5-.56-.25-.94-.8-.94-1.45 0-.88.72-1.6 1.6-1.6.43 0 .82.17 1.11.45 1.1-.78 2.6-1.28 4.27-1.33l.81-3.79c.05-.21.25-.35.46-.3l2.65.56c.22-.43.67-.73 1.19-.73.74 0 1.33.6 1.33 1.33s-.6 1.33-1.33 1.33-1.33-.59-1.33-1.32l-2.22-.47-.68 3.2c1.64.06 3.11.56 4.2 1.33.29-.28.68-.45 1.11-.45.88 0 1.6 .72 1.6 1.6 0 .65-.38 1.2-.94 1.45M9.25 13c-.69 0-1.25.56-1.25 1.25s.56 1.25 1.25 1.25 1.25-.56 1.25-1.25S9.94 13 9.25 13m5.5 0c-.69 0-1.25.56-1.25 1.25s.56 1.25 1.25 1.25S16 14.94 16 14.25 15.44 13 14.75 13m-5.32 3.16c-.18-.18-.18-.47 0-.65.18-.18.47-.18.65 0 .64.64 1.71.97 2.92.97s2.28-.33 2.92-.97c.18-.18.47-.18.65 0 .18.18.18.47 0 .65-.83.83-2.12 1.24-3.57 1.24s-2.74-.41-3.57-1.24Z"/></svg>
      <span>Reddit</span>
    </a>
    <button type="button" id="copy-link-btn" class="share-pill" data-url={url}>
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
      <span id="copy-link-text">Link kopieren</span>
    </button>
  </div>
</div>

<script>
  const copyBtn = document.getElementById("copy-link-btn");
  const copyText = document.getElementById("copy-link-text");
  copyBtn?.addEventListener("click", async () => {
    const url = copyBtn.getAttribute("data-url");
    if (!url || !copyText) return;
    await navigator.clipboard.writeText(url);
    const original = copyText.textContent;
    copyText.textContent = "Kopiert!";
    copyBtn.classList.add("copied");
    setTimeout(() => {
      copyText.textContent = original;
      copyBtn.classList.remove("copied");
    }, 2000);
  });
</script>

<style>
  .share-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
  .share-label { font-size: 0.82rem; font-weight: 600; color: var(--text-dim); }
  .share-buttons { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .share-pill { display: inline-flex; align-items: center; gap: 0.4rem; font-size: 0.8rem; font-weight: 500; font-family: inherit; color: var(--text-muted); background: var(--bg-elevated); border: 1px solid var(--border); padding: 0.3rem 0.75rem; border-radius: 6px; text-decoration: none; cursor: pointer; transition: all 0.15se ease; }
  .share-pill:hover { color: var(--text-main); border-color: var(--accent); }
  .share-pill.copied { color: #4ade80; border-color: #22c55e; }
</style>