---
interface Props { title: string; url: string; }
const { title, url } = Astro.props;
const t = encodeURIComponent(title);
const u = encodeURIComponent(url);
const li = "https://www.linkedin.com/sharing/share-offsite/?url=" + u;
const tw = "https://twitter.com/intent/tweet?text=" + t + "&url=" + u;
const rd = "https://www.reddit.com/submit?url=" + u + "&title=" + t;
---
<div class="share-bar" data-pagefind-ignore>
  <button type="button" id="like-btn" class="action-pill like-pill" data-slug={Astro.url.pathname}>
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path></svg>
    <span>Hilfreich</span>
    <span id="like-count" class="like-count">0</span>
  </button>
  <div class="share-group">
    <span class="share-label">Teilen:</span>
    <a href={li} target="_blank" rel="noopener noreferrer" class="action-pill">LinkedIn</a>
    <a href={tw} target="_blank" rel="noopener noreferrer" class="action-pill">X</a>
    <a href={rd} target="_blank" rel="noopener noreferrer" class="action-pill">Reddit</a>
    <button type="button" id="copy-link-btn" class="action-pill" data-url={url}><span id="copy-link-text">Link</span></button>
  </div>
</div>
<script>
  const lb = document.getElementById("like-btn");
  const lc = document.getElementById("like-count");
  if (lb && lc) {
    const k = "sysai_liked_" + (lb.getAttribute("data-slug") || location.pathname);
    let ok = localStorage.getItem(k) === "1";
    lc.textContent = ok ? "1" : "0";
    lb.classList.toggle("liked", ok);
    lb.addEventListener("click", () => { ok = !ok; localStorage.setItem(k, ok ? "1" : "0"); lc.textContent = ok ? "1" : "0"; lb.classList.toggle("liked", ok); });
  }
  const cb = document.getElementById("copy-link-btn");
  const ct = document.getElementById("copy-link-text");
  cb?.addEventListener("click", async () => {
    await navigator.clipboard.writeText(cb.getAttribute("data-url") || location.href);
    if (ct) ct.textContent = "Kopiert!";
    cb.classList.add("copied");
    setTimeout(() => { if (ct) ct.textContent = "Link"; cb.classList.remove("copied"); }, 2000);
  });
</script>
<style>
  .share-bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; margin-top: 1.25rem; padding-top: 1.1rem; border-top: 1px solid var(--border); }
  .share-group { display: flex; flex-wrap: wrap; align-items: center; gap: 0.45rem; }
  .share-label { font-size: 0.82rem; font-weight: 600; color: var(--text-dim); margin-right: 0.15rem; }
  .action-pill { display: inline-flex; align-items: center; gap: 0.38rem; font-size: 0.8rem; font-weight: 500; font-family: inherit; color: var(--text-muted); background: var(--bg-elevated); border: 1px solid var(--border); padding: 0.28rem 0.7rem; border-radius: 99px; text-decoration: none; cursor: pointer; transition: all 0.15s ease; }
  .action-pill:hover { color: var(--text-main); border-color: var(--accent); }
  .like-pill.liked { color: var(--accent-light, #60a5fa); border-color: var(--accent); background: rgba(59, 130, 246, 0.12); }
  .like-count { font-weight: 700; font-size: 0.75rem; padding-left: 0.25rem; border-left: 1px solid var(--border); }
  .action-pill.copied { color: #4ade80; border-color: #22c55e; }
</style>