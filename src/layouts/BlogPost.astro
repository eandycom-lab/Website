---
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";
import FormattedDate from "../components/FormattedDate.astro";

interface Heading {
depth: number;
slug: string;
text: string;
}

const {
title,
description,
pubDate,
updatedDate,
heroImage,
category,
tags = [],
currentId,
headings = [],
readingTime,
} = Astro.props;

const slugify = (text: string) =>
text
.toLowerCase()
.replace(/ä/g, "ae")
.replace(/ö/g, "oe")
.replace(/ü/g, "ue")
.replace(/ß/g, "ss")
.replace(/[^a-z0-9]+/g, "-")
.replace(/(^-|-$)/g, "");

const resolveImg = (img?: string) => {
if (!img) return "/blog-placeholder-1.jpg";
return img.replace("../../assets/", "/");
};

const activeCategory = category || "Self-Hosting";
const categoryUrl = `/category/${slugify(activeCategory)}/`;
const breadcrumbs = [
{ name: "Home", url: "/" },
{ name: activeCategory, url: categoryUrl },
{ name: title, url: Astro.url.pathname },
];

const heroSrc = resolveImg(typeof heroImage === "string" ? heroImage : heroImage?.src);
const tocHeadings = (headings as Heading[]).filter((h) => h.depth === 2 || h.depth === 3);

const allPosts = (await getCollection("blog")).sort(
(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const currentTags = new Set((tags as string[]).map((t) => t.toLowerCase()));
const relatedPosts = allPosts
.filter((p) => p.id !== currentId)
.map((p) => {
let score = 0;
if ((p.data.category || "Self-Hosting") === activeCategory) score += 2;
for (const t of p.data.tags ?? []) {
if (currentTags.has(t.toLowerCase())) score += 3;
}
return { post: p, score };
})
.filter((item) => item.score > 0)
.sort((a, b) => b.score - a.score || b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf())
.slice(0, 2)
.map((item) => item.post);
---

<html lang="de">
<head>
<BaseHead
title={title}
description={description}
image={heroSrc}
pubDate={pubDate}
updatedDate={updatedDate}
category={activeCategory}
tags={tags}
isArticle={true}
breadcrumbs={breadcrumbs}
/>
</head>
<body>
<Header />
<main class="container mag-layout">
<div class="article-column">
<article class="article-box" data-pagefind-body>
<nav class="breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore>
<a href="/">Home</a>
<span class="crumb-sep">/</span>
<a href={categoryUrl}>{activeCategory}</a>
<span class="crumb-sep">/</span>
<span class="crumb-current">{title}</span>
</nav>

<div>
<span class="badge" data-pagefind-filter="Kategorie">{activeCategory}</span>
<h1 style="font-size: 2rem; line-height: 1.25; margin: 0.75rem 0 0.5rem;">{title}</h1>
<div class="meta-date">
Veröffentlicht am <FormattedDate date={pubDate} />
{updatedDate && (
<span> • Aktualisiert am <FormattedDate date={updatedDate} /></span>
)}
{readingTime && (
<span> • {readingTime} Min. Lesezeit</span>
)}
</div>
</div>

{heroSrc && <img class="article-hero" src={heroSrc} alt={title} />}

{tocHeadings.length >= 2 && (
<details class="toc-box" open data-pagefind-ignore>
<summary class="toc-title">Inhaltsverzeichnis</summary>
<ul class="toc-list">
{tocHeadings.map((h) => (
<li class={`toc-item depth-${h.depth}`}>
<a href={`#${h.slug}`}>{h.text}</a>
</li>
))}
</ul>
</details>
)}

<div class="prose">
<slot />
</div>

{tags.length > 0 && (
<div class="tag-bar" data-pagefind-ignore>
<span class="tag-label">Tags:</span>
{(tags as string[]).map((t) => (
<a href={`/tag/${slugify(t)}/`} class="tag-pill">#{t}</a>
))}
</div>
)}
</article>

{relatedPosts.length > 0 && (
<section class="related-section" data-pagefind-ignore>
<h2 class="section-header">Ähnliche Artikel</h2>
<div class="post-grid">
{relatedPosts.map((rel) => (
<a href={`/blog/${rel.id}/`} class="post-card">
<div class="card-thumb">
<span class="badge">{rel.data.category || "Self-Hosting"}</span>
<img src={resolveImg(rel.data.heroImage)} alt={rel.data.title} loading="lazy" />
</div>
<div class="card-body">
<div class="meta-date"><FormattedDate date={rel.data.pubDate} /></div>
<h3 class="card-title">{rel.data.title}</h3>
<p class="card-desc">{rel.data.description}</p>
</div>
</a>
))}
</div>
</section>
)}
</div>

<Sidebar />
</main>
<Footer />

<script>
document.querySelectorAll(".prose pre").forEach((pre) => {
if (pre.parentElement?.classList.contains("code-wrapper")) return;

const wrapper = document.createElement("div");
wrapper.className = "code-wrapper";
pre.parentNode?.insertBefore(wrapper, pre);
wrapper.appendChild(pre);

const btn = document.createElement("button");
btn.type = "button";
btn.className = "copy-code-btn";
btn.textContent = "Kopieren";
btn.setAttribute("aria-label", "Code in Zwischenablage kopieren");

btn.addEventListener("click", async () => {
const code = pre.querySelector("code")?.innerText ?? pre.textContent ?? "";
try {
await navigator.clipboard.writeText(code);
btn.textContent = "Kopiert!";
btn.classList.add("copied");
setTimeout(() => {
btn.textContent = "Kopieren";
btn.classList.remove("copied");
}, 2000);
} catch {
btn.textContent = "Fehler";
}
});

wrapper.appendChild(btn);
});
</script>

<style>
.article-column {
min-width: 0;
}
.breadcrumbs {
display: flex;
flex-wrap: wrap;
align-items: center;
gap: 0.45rem;
font-size: 0.8rem;
color: var(--text-dim);
margin-bottom: 1rem;
}
.breadcrumbs a {
color: var(--text-muted);
}
.breadcrumbs a:hover {
color: var(--accent-light);
}
.crumb-sep {
color: var(--text-dim);
}
.crumb-current {
color: var(--text-dim);
overflow: hidden;
text-overflow: ellipsis;
white-space: nowrap;
max-width: 340px;
}
.toc-box {
background: rgba(30, 41, 59, 0.55);
border: 1px solid var(--border);
border-left: 3px solid var(--accent);
border-radius: 8px;
padding: 1rem 1.25rem;
margin: 0 0 1.75rem 0;
}
.toc-title {
font-size: 0.9rem;
font-weight: 700;
text-transform: uppercase;
letter-spacing: 0.05em;
color: var(--text-main);
cursor: pointer;
user-select: none;
}
.toc-list {
list-style: none;
padding: 0.75rem 0 0 0;
margin: 0;
display: flex;
flex-direction: column;
gap: 0.4rem;
}
.toc-item a {
font-size: 0.92rem;
color: var(--text-muted);
display: inline-block;
line-height: 1.4;
}
.toc-item a:hover {
color: var(--accent-light);
}
.toc-item.depth-3 {
padding-left: 1.15rem;
font-size: 0.86rem;
}
.toc-item.depth-3 a::before {
content: "↳ ";
color: var(--text-dim);
}
.tag-bar {
display: flex;
flex-wrap: wrap;
align-items: center;
gap: 0.5rem;
margin-top: 2.25rem;
padding-top: 1.25rem;
border-top: 1px solid var(--border);
}
.tag-label {
font-size: 0.82rem;
font-weight: 600;
color: var(--text-dim);
margin-right: 0.25rem;
}
.tag-pill {
font-size: 0.8rem;
font-weight: 500;
color: var(--text-muted);
background: var(--bg-elevated);
border: 1px solid var(--border);
padding: 0.22rem 0.65rem;
border-radius: 99px;
transition: all 0.15s ease;
}
.tag-pill:hover {
color: var(--text-main);
border-color: var(--accent);
}
.related-section {
margin-top: 2.5rem;
}
:global(.prose h2),
:global(.prose h3) {
scroll-margin-top: 84px;
}
:global(.code-wrapper) {
position: relative;
margin: 1.25rem 0;
}
:global(.code-wrapper pre) {
margin: 0;
padding-top: 2.35rem;
}
:global(.copy-code-btn) {
position: absolute;
top: 0.5rem;
right: 0.5rem;
padding: 0.25rem 0.6rem;
font-size: 0.75rem;
font-weight: 600;
color: var(--text-muted);
background: var(--bg-elevated);
border: 1px solid var(--border);
border-radius: 5px;
cursor: pointer;
transition: all 0.15s ease;
}
:global(.copy-code-btn:hover) {
color: var(--text-main);
border-color: var(--accent);
}
:global(.copy-code-btn.copied) {
color: #4ade80;
border-color: #22c55e;
}
</style>
</body>
</html>
