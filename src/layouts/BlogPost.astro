---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";
import FormattedDate from "../components/FormattedDate.astro";

const { title, description, pubDate, updatedDate, heroImage, category } = Astro.props;

const rawHero = typeof heroImage === "string" ? heroImage : heroImage?.src;
const heroSrc = rawHero ? rawHero.replace("../../assets/", "/") : "/blog-placeholder-1.jpg";
---

<html lang="de">
<head>
<BaseHead title={title} description={description} />
</head>
<body>
<Header />
<main class="container mag-layout">
<article class="article-box">
<div>
<span class="badge">{category || "Self-Hosting"}</span>
<h1 style="font-size: 2rem; line-height: 1.25; margin: 0.75rem 0 0.5rem;">{title}</h1>
<div class="meta-date">
Veröffentlicht am <FormattedDate date={pubDate} />
{updatedDate && (
<span> • Aktualisiert am <FormattedDate date={updatedDate} /></span>
)}
</div>
</div>

{heroSrc && <img class="article-hero" src={heroSrc} alt={title} />}

<div class="prose">
<slot />
</div>
</article>

<Sidebar />
</main>
<Footer />
</body>
</html>
