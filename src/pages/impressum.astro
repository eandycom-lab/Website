      Wir sind nicht bereit oder verpflichtet, an Streitbeilegungsverfahren vor einer Verbraucherschlichtungsstelle teilzunehmen.
    </p>
  </main>
<style>
  .legal-page {
    max-width: 820px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 4rem;
    line-height: 1.75;
    color: var(--text, #e2e8f0);
  }
  .legal-page h1 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    color: var(--text-bright, #f8fafc);
  }
  .legal-page h2 {
    font-size: 1.35rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    color: var(--accent, #38bdf8);
    border-bottom: 1px solid var(--border, #1e293b);
    padding-bottom: 0.35rem;
  }
  .legal-page h3 {
    font-size: 1.1rem;
    margin-top: 1.4rem;
    margin-bottom: 0.5rem;
    color: var(--text-bright, #f8fafc);
  }
  .legal-page p, .legal-page ul {
    margin-bottom: 1rem;
    color: var(--text-dim, #94a3b8);
  }
  .legal-page ul {
    padding-left: 1.4rem;
  }
  .legal-page li {
    margin-bottom: 0.6rem;
  }
  .legal-page a {
    color: var(--accent, #38bdf8);
    text-decoration: underline;
  }
  .legal-page code {
    background: rgba(56, 189, 248, 0.1);
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    font-size: 0.9em;
  }
</style>
<Footer />

<script is:inline>
(function () {
const form = document.getElementById("sysai-contact-form");
const statusBox = document.getElementById("contact-status");
const submitBtn = document.getElementById("contact-submit-btn");
const loadedInput = document.getElementById("form_loaded_at");
if (!form || !statusBox || !submitBtn) return;

const startTime = Date.now();
if (loadedInput) loadedInput.value = String(startTime);

function showStatus(msg, isError) {
statusBox.textContent = msg;
statusBox.className = "form-status " + (isError ? "error" : "success");
statusBox.style.display = "block";
}

form.addEventListener("submit", async (e) => {
e.preventDefault();

const hp = form.querySelector("input[name=\"botcheck\"]");
if (hp && hp.value) {
showStatus("Danke! Deine Nachricht wurde gesendet.", false);
form.reset();
return;
}

if (Date.now() - startTime < 2500) {
showStatus("Bitte nimm dir einen kurzen Moment Zeit, bevor du das Formular absendest.", true);
return;
}

if (!form.checkValidity()) {
form.reportValidity();
return;
}

const formData = new FormData(form);

submitBtn.disabled = true;
submitBtn.textContent = "Wird gesendet...";
statusBox.style.display = "none";

try {
const response = await fetch("https://api.web3forms.com/submit", {
method: "POST",
body: formData,
});
const result = await response.json();

if (result.success) {
showStatus("Vielen Dank! Deine Nachricht ist angekommen.", false);
form.reset();
} else {
showStatus(result.message || "Senden fehlgeschlagen. Bitte versuche es später erneut.", true);
}
} catch {
showStatus("Netzwerkfehler beim Senden. Bitte prüfe deine Verbindung.", true);
} finally {
submitBtn.disabled = false;
submitBtn.textContent = "Nachricht absenden";
}
});
})();
</script>

<style>
.contact-intro {
color: var(--text-muted);
font-size: 0.98rem;
line-height: 1.6;
margin-bottom: 1.75rem;
}
.contact-form {
display: flex;
flex-direction: column;
gap: 1.15rem;
}
.hp-field {
position: absolute;
left: -9999px;
opacity: 0;
pointer-events: none;
}
.form-row {
display: grid;
grid-template-columns: 1fr 1fr;
gap: 1rem;
}
@media (max-width: 640px) {
.form-row {
grid-template-columns: 1fr;
}
}
.form-group {
display: flex;
flex-direction: column;
gap: 0.4rem;
}
.form-group label {
font-size: 0.85rem;
font-weight: 600;
color: var(--text-main);
}
.form-group input,
.form-group select,
.form-group textarea {
width: 100%;
padding: 0.65rem 0.85rem;
border-radius: 8px;
border: 1px solid var(--border);
background: var(--bg-main);
color: var(--text-main);
font-family: inherit;
font-size: 0.95rem;
outline: none;
transition: border-color 0.15s ease;
}
.form-group input:focus,
.form-group select:focus,
.form-group textarea:focus {
border-color: var(--accent);
}
.checkbox-card {
display: flex;
align-items: flex-start;
gap: 0.75rem;
padding: 0.9rem 1rem;
border-radius: 8px;
background: rgba(30, 41, 59, 0.55);
border: 1px solid var(--border);
cursor: pointer;
transition: border-color 0.15s ease;
}
.checkbox-card:hover {
border-color: var(--accent);
}
.checkbox-card input[type="checkbox"] {
margin-top: 0.2rem;
width: 17px;
height: 17px;
accent-color: var(--accent);
flex-shrink: 0;
}
.checkbox-card strong {
display: block;
font-size: 0.9rem;
color: var(--text-main);
margin-bottom: 0.2rem;
}
.checkbox-card small {
display: block;
font-size: 0.8rem;
color: var(--text-muted);
line-height: 1.45;
}
.submit-btn {
padding: 0.75rem 1.5rem;
border: none;
border-radius: 8px;
background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
color: #ffffff;
font-size: 0.95rem;
font-weight: 700;
cursor: pointer;
transition: opacity 0.15s ease, transform 0.15s ease;
}
.submit-btn:hover:not(:disabled) {
opacity: 0.92;
transform: translateY(-1px);
}
.submit-btn:disabled {
opacity: 0.6;
cursor: not-allowed;
}
.form-status {
display: none;
padding: 0.85rem 1rem;
border-radius: 8px;
font-size: 0.9rem;
font-weight: 500;
}
.form-status.success {
background: rgba(34, 197, 94, 0.12);
border: 1px solid rgba(34, 197, 94, 0.4);
color: #4ade80;
}
.form-status.error {
background: rgba(239, 68, 68, 0.12);
border: 1px solid rgba(239, 68, 68, 0.4);
color: #f87171;
}
</style>
</body>
</html>

