---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";
import { SITE_TITLE } from "../consts";

const WEB3FORMS_ACCESS_KEY = "fbcb1b6d-0397-4752-8306-d024ec262772";
---

<html lang="de">
<head>
<BaseHead
title="Impressum | sysai.sh"`}
description="Impressum und gesetzliche Pflichtangaben f?r sysai.sh".`}
/>
</head>
<body>
<Header />
<main class="container legal-page">
    <h1>Impressum</h1>

    <h2>Angaben gem?? ? 5 DDG</h2>
    <p>
      Andreas Thieme<br />
      [Stra?e Hausnummer / c/o Impressums-Service]<br />
      [PLZ Ort]<br />
      Deutschland
    </p>

    <h2>Kontakt</h2>
    <p>
      Kontaktformular: <a href="/kontakt/">https://sysai.sh/kontakt/</a><br />
      E-Mail: <a href="mailto:kontakt@sysai.sh">kontakt@sysai.sh</a>
    </p>

    <h2>Verantwortlich f?r den Inhalt nach ? 18 Abs. 2 MStV</h2>
    <p>
      Andreas Thieme<br />
      [Stra?e Hausnummer / c/o Impressums-Service]<br />
      [PLZ Ort]
    </p>

    <h2>EU-Streitschlichtung</h2>
    <p>
      Die Europ?ische Kommission stellt eine Plattform zur Online-Streitbeilegung (OS) bereit:
      <a href="https://ec.europa.eu/consumers/odr/" target="_blank" rel="noopener noreferrer">https://ec.europa.eu/consumers/odr/</a>.<br />
      Unsere E-Mail-Adresse finden Sie oben im Impressum.
    </p>

    <h2>Verbraucherstreitbeilegung / Universalschlichtungsstelle</h2>
