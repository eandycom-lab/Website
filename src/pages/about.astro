---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import settings from "../data/settings.json";
---

<!doctype html>
<html lang="de">
	<head>
		<BaseHead title={`${settings.aboutTitle} | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="container mag-layout">
			<article class="article-box">
				<span class="badge">Über</span>
				<h1 style="font-size: 2rem; line-height: 1.25; margin: 0.75rem 0 1.25rem;">
					{settings.aboutTitle}
				</h1>
				<div class="prose">
					<p>{settings.aboutText}</p>
				</div>
			</article>
			<Sidebar />
		</main>
		<Footer />
	</body>
</html>