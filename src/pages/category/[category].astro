---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Sidebar from "../../components/Sidebar.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";
import { getCollection } from "astro:content";
import settings from "../../data/settings.json";

export async function getStaticPaths() {
	const slugify = (text: string) =>
		text
			.toLowerCase()
			.replace(/ä/g, "ae")
			.replace(/ö/g, "oe")
			.replace(/ü/g, "ue")
			.replace(/ß/g, "ss")
			.replace(/[^a-z0-9]+/g, "-")
			.replace(/(^-|-$)/g, "");

	const allPosts = (await getCollection("blog")).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);

	const categorySet = new Set<string>(settings.categories || []);
	for (const post of allPosts) {
		categorySet.add(post.data.category || "Self-Hosting");
	}

	return Array.from(categorySet).map((catName) => {
		const filteredPosts = allPosts.filter(
			(post) => (post.data.category || "Self-Hosting") === catName
		);
		return {
			params: { category: slugify(catName) },
			props: { categoryName: catName, posts: filteredPosts },
		};
	});
}

const { categoryName, posts } = Astro.props;

const resolveImg = (img?: string) => {
	if (!img) return "/blog-placeholder-1.jpg";
	return img.replace("../../assets/", "/");
};
---

<!doctype html>
<html lang="de">
	<head>
		<BaseHead title={`${categoryName} | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="container mag-layout">
			<section>
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
					<h2 class="section-header" style="margin: 0;">Kategorie: {categoryName}</h2>
					<a href="/" style="font-size: 0.85rem; color: var(--accent-light);">← Alle Beiträge</a>
				</div>

				{posts.length === 0 ? (
					<div class="article-box" style="text-align: center; padding: 3rem 1.5rem;">
						<p style="color: var(--text-muted); margin: 0 0 1rem 0;">
							In der Kategorie <strong>{categoryName}</strong> sind aktuell noch keine Beiträge veröffentlicht.
						</p>
						<a href="/" class="badge">Zurück zur Startseite</a>
					</div>
				) : (
					<div class="post-grid">
						{posts.map((post) => (
							<a href={`/blog/${post.id}/`} class="post-card">
								<div class="card-thumb">
									<img src={resolveImg(post.data.heroImage)} alt={post.data.title} loading="lazy" />
									<span class="badge">{post.data.category || "Self-Hosting"}</span>
								</div>
								<div class="card-body">
									<div class="meta-date">
										<FormattedDate date={post.data.pubDate} />
									</div>
									<h3 class="card-title">{post.data.title}</h3>
									<p class="card-desc">{post.data.description}</p>
								</div>
							</a>
						))}
					</div>
				)}
			</section>

			<Sidebar />
		</main>
		<Footer />
	</body>
</html>