---
import { getCollection } from "astro:content";
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Sidebar from "../../components/Sidebar.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { SITE_TITLE } from "../../consts";

const slugify = (text: string) =>
text
.toLowerCase()
.replace(/ä/g, "ae")
.replace(/ö/g, "oe")
.replace(/ü/g, "ue")
.replace(/ß/g, "ss")
.replace(/[^a-z0-9]+/g, "-")
.replace(/(^-|-$)/g, "");

export async function getStaticPaths() {
const slugifyFn = (text: string) =>
text
.toLowerCase()
.replace(/ä/g, "ae")
.replace(/ö/g, "oe")
.replace(/ü/g, "ue")
.replace(/ß/g, "ss")
.replace(/[^a-z0-9]+/g, "-")
.replace(/(^-|-$)/g, "");

const posts = await getCollection("blog");
const tagMap = new Map<string, string>();
for (const post of posts) {
for (const t of post.data.tags ?? []) {
const s = slugifyFn(t);
if (s && !tagMap.has(s)) tagMap.set(s, t);
}
}

return Array.from(tagMap.entries()).map(([slug, label]) => ({
params: { tag: slug },
props: { tagLabel: label },
}));
}

const { tag } = Astro.params;
const { tagLabel } = Astro.props;

const allPosts = (await getCollection("blog")).sort(
(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const posts = allPosts.filter((p) =>
(p.data.tags ?? []).some((t) => slugify(t) === tag)
);

const resolveImg = (img?: string) => {
if (!img) return "/blog-placeholder-1.jpg";
return img.replace("../../assets/", "/");
};
---

<html lang="de">
<head>
<BaseHead
title={`#${tagLabel} – ${SITE_TITLE}`}
description={`Alle Artikel mit dem Tag #${tagLabel} auf ${SITE_TITLE}`}
/>
</head>
<body>
<Header />
<main class="container mag-layout">
<section>
<h1 class="section-header">Tag: #{tagLabel} ({posts.length})</h1>
<div class="post-grid">
{posts.map((post) => (
<a href={`/blog/${post.id}/`} class="post-card">
<div class="card-thumb">
<span class="badge">{post.data.category || "Self-Hosting"}</span>
<img src={resolveImg(post.data.heroImage)} alt={post.data.title} loading="lazy" />
</div>
<div class="card-body">
<div class="meta-date"><FormattedDate date={post.data.pubDate} /></div>
<h2 class="card-title">{post.data.title}</h2>
<p class="card-desc">{post.data.description}</p>
</div>
</a>
))}
</div>
</section>
<Sidebar />
</main>
<Footer />
</body>
</html>
